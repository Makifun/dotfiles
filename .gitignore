kitty/.config/kitty/kitty.conf.bak
zsh/extra_zish/*appleshit.zsh
/talos/.talos/keys
/environment.d/.config/environment.d/10-home-manager.conf
/environment.d/.config/environment.d/50-ssh-askpass.conf

# antigravity: whitelist. Git cannot re-include a file inside an ignored
# directory, so each parent level is re-included and its contents ignored.
/antigravity/*
!/antigravity/.config/
/antigravity/.config/*
!/antigravity/.config/Antigravity IDE/
/antigravity/.config/Antigravity IDE/*
!/antigravity/.config/Antigravity IDE/settings.json
!/antigravity/.config/Antigravity IDE/User/
/antigravity/.config/Antigravity IDE/User/*
!/antigravity/.config/Antigravity IDE/User/keybindings.json
!/antigravity/.config/Antigravity IDE/User/settings.json

# claude: whitelist
/claude/*
!/claude/.claude/
/claude/.claude/*
!/claude/.claude/settings.json
!/claude/.claude/CLAUDE.md
!/claude/.claude/statusline/
